#!/usr/bin/env bash
# Cổng commit: chạy với mọi cách gọi git commit. Commit có mã cần:
#  1) có task đang làm và tệp task đủ mục;
#  2) dấu duyệt của reviewer cho đúng phần mã đã stage (.git/crm-review/<staged_code_hash>), trỏ tới bản ghi
#     hội thoại thật của reviewer (scripts/agent/stamp_check.py).
cd "$(git rev-parse --show-toplevel)" || exit 1
. scripts/agent/lib.sh
# Commit gộp nhánh task đã review: cho qua khi mọi tệp mã đã stage giống hệt bản trên nhánh được gộp
# (MERGE_HEAD). Tệp mã bị sửa tay khi gộp (giải xung đột) thì phải qua đủ cổng như commit thường.
gd=$(git rev-parse --git-dir)
if [ -f "$gd/MERGE_HEAD" ]; then
  mh=$(head -1 "$gd/MERGE_HEAD"); bad=""
  gen=""
  for f in $(git diff --cached --name-only HEAD | grep -E "$(code_paths_regex)"); do
    staged=$(git rev-parse -q --verify ":$f" 2>/dev/null || echo deleted)
    theirs=$(git rev-parse -q --verify "$mh:$f" 2>/dev/null || echo deleted)
    [ "$staged" = "$theirs" ] && continue
    # Mã sinh là hàm cố định của nguồn: cho khác bản nhánh, nhưng phải đúng bằng `make gen` từ nguồn đã gộp (kiểm dưới).
    if is_generated_path "$f"; then gen=1; continue; fi
    # Tệp viết tay: cho qua khi đúng bằng kết quả git TỰ TRỘN (không xung đột, không ai sửa tay) từ hai bản đã review.
    if [ -n "${automerge_tree:-}" ] || automerge_tree=$(git merge-tree --write-tree HEAD "$mh" 2>/dev/null | head -1); then
      auto=$(git rev-parse -q --verify "$automerge_tree:$f" 2>/dev/null || echo deleted)
      [ "$staged" = "$auto" ] && continue
    fi
    bad="$bad $f"
  done
  if [ -z "$bad" ] && [ -n "$gen" ]; then
    export PATH="$HOME/go/bin:$PATH"
    if ! make gen >/dev/null 2>&1 || ! git diff --quiet -- internal/httpapi/gen internal/httpapi/routes_gen.go console/src/api $(git ls-files 'internal/*/internal/store/*' 'internal/store/*'); then
      echo "Cổng commit (gộp nhánh): mã sinh đã stage không khớp 'make gen' từ nguồn đã gộp. Chạy make gen, git add mã sinh, rồi commit lại." >&2; exit 1
    fi
  fi
  if [ -z "$bad" ]; then exit 0; fi
  echo "Cổng commit (gộp nhánh): các tệp mã sau khác bản đã review trên nhánh được gộp:$bad" >&2
fi
if git diff --cached --name-only | grep -E -q "$(code_paths_regex)"; then
  st=$(sed -n 's/^Trạng thái: *//p' "$(git rev-parse --git-dir)/crm-task-state" 2>/dev/null | head -1)
  if [ "$st" != "đang làm" ]; then
    echo "Cổng commit: commit có mã cần một task đang làm (scripts/agent/new-task.sh)." >&2; exit 1
  fi
  if ! CLAUDE_PROJECT_DIR=$(pwd) scripts/agent/task-check.sh --commit; then
    echo "Cổng commit: tệp task chưa đủ mục." >&2; exit 1
  fi
  tree=$(staged_code_hash)
  if [ ! -f "$(review_dir)/$tree" ]; then
    echo "Cổng commit: chưa có kết luận ĐẠT của reviewer cho đúng phần đã stage (mã băm $tree). Stage xong rồi chạy agent reviewer; sửa gì sau khi review thì phải review lại." >&2; exit 1
  fi
  python3 scripts/agent/stamp_check.py "$(review_dir)/$tree" "$tree" || exit 1
fi
# Quét bí mật trong phần đã stage (mọi commit, kể cả commit chỉ có tài liệu) — đề xuất Task 23.
export PATH="$HOME/go/bin:$PATH"
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --no-banner --redact . >/dev/null 2>&1; then
    echo "Cổng commit: gitleaks thấy bí mật trong phần đã stage. Chạy: gitleaks git --pre-commit --staged --redact ." >&2; exit 1
  fi
fi
exit 0
